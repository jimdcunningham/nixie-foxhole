<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FoxWatchMonitor</AssemblyName>
    <RootNamespace>FoxWatchMonitor</RootNamespace>
    <ApplicationIcon>..\..\..\apps\nixie-electron\build\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\icons\clock.svg" LogicalName="FoxWatchMonitor.Assets.clock.svg" />
    <EmbeddedResource Include="assets\icons\hourglass.svg" LogicalName="FoxWatchMonitor.Assets.hourglass.svg" />
  </ItemGroup>
</Project>
