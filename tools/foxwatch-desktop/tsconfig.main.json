{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts", "shared/**/*.ts"]
}
