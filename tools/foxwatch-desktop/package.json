{
  "name": "@nixie/foxwatch-desktop",
  "productName": "FoxWatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && node scripts/dev.mjs",
    "start": "electron .",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-release-pin.mjs",
    "build": "npm run typecheck && npm run build:main && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "vue": "3.5.44",
    "pixi.js": "8.22.0",
    "@pixi/3d": "file:vendor/pixi-3d-0.1.0-beta.2.tgz",
    "meshoptimizer": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.0.0",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
