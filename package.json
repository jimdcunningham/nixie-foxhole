{
  "name": "nixie-foxhole",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Foxhole tooling and Nixie extension workspace",
  "workspaces": [
    "extensions/*",
    "packages/*",
    "packages/extensions/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:foxwatch": "npm run build --workspace @nixie/foxwatch",
    "foxwatch": "node ./tools/foxwatch/run-foxwatch.mjs",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
