{
  "name": "nixie-foxhole",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Foxhole tooling and Nixie extension workspace",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:foxwatch": "npm run build --workspace @nixie/foxwatch",
    "build:monitor": "dotnet build ./tools/foxwatch/monitor/FoxWatchMonitor.csproj",
    "foxwatch": "node ./tools/foxwatch/run-foxwatch.mjs",
    "test:source-media": "node ./tools/check-source-media.mjs && node --test ./tools/check-source-media.test.mjs",
    "test": "npm run test:source-media && npm run test --workspaces --if-present",
    "assets:inventory": "node ./tools/foxwatch/scripts/asset-publication-inventory.mjs",
    "assets:refresh-world-receipts": "node ./packages/foxhole-world/catalog-references.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
