{
  "schemaVersion": 1,
  "stages": {
    "extract": [
      "tools/foxwatch/**/*.cs",
      "tools/foxwatch/**/*.csproj",
      "tools/foxwatch/appsettings*.json"
    ],
    "hydrate": [
      "tools/foxwatch/asset-overrides/**/*",
      "tools/foxwatch/category-overrides/**/*.json",
      "tools/foxwatch/localization-overrides/**/*.json",
      "tools/foxwatch/*whitelist*.json"
    ],
    "scene": [
      "tools/foxwatch/pose-overrides/**/*.json",
      "tools/foxwatch/asset-overrides/**/*"
    ],
    "render": [
      "tools/foxwatch/blender/**/*.py",
      "tools/foxwatch/blender/**/*.blend",
      "tools/foxwatch/render-overrides/**/*"
    ],
    "publish": [
      "tools/foxwatch/scripts/**/*",
      "tools/foxwatch/run-foxwatch.mjs",
      "tools/foxwatch/regen-stages.v1.json",
      "tools/foxwatch/ASSET-OUTPUT.md"
    ]
  }
}
